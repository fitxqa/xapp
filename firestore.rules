rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid;
    }
    match /chats/{chatId} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create, update: if signed() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      match /messages/{msgId} {
        allow read, create, update: if signed() && chatId.split('_').hasAny([request.auth.uid]);
      }
    }
    match /calls/{callId} {
      allow create: if signed() && request.resource.data.caller == request.auth.uid;
      allow read, update: if signed()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      match /{side}/{candId} { allow read, create: if signed(); }
    }
    match /statuses/{sid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }
    match /media/{mediaId} {
      allow read, create: if signed();
      match /parts/{part} { allow read, create: if signed(); }
    }
  }
}
